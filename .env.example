# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables (Production + Preview).
#
# Only PUBLIC values belong here: the Supabase publishable (anon) key is
# designed to ship to browsers - Row-Level Security protects the data.
# NEVER put the database password, service_role key or sb_secret_ key in any
# VITE_* variable: everything prefixed VITE_ is compiled into the client bundle.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Shared password of the four demonstration accounts (shown on the login page).
# Leave empty to hide the demo-access panel.
VITE_DEMO_PASSWORD=
